{
  "_spec": {
    "name": "保险/金融直播封面 · 统一模板结构规范",
    "version": "v4.0",
    "note": "统一模板结构 × 多平台产出。平台（platform）决定画布规格、平台安全区与推荐的视觉风格族；风格族（family）决定视觉语言；排版模式（layoutMode）由有没有主播半身像决定。三层正交，互不耦合。",
    "families": [
      {
        "id": "classic",
        "name": "经典稳重",
        "note": "深色厚底 / 金融专业感，适合中高净值与政企客群"
      },
      {
        "id": "youth",
        "name": "年轻活力",
        "note": "浅色渐变底 / 渐变大字 / 星光点缀，适合短视频与私域年轻客群"
      },
      {
        "id": "xhs",
        "name": "小红书笔记",
        "platform": "xhs",
        "note": "浅底大黑字 / 关键词荧光高亮 / 作者行 + 话题标签带，信息流里一眼可读"
      },
      {
        "id": "douyin",
        "name": "抖音竖屏",
        "platform": "douyin",
        "note": "高饱和渐变底 / 超大描边标题 / 话题条 + 页码，按平台安全区内缩排版"
      }
    ],
    "zones": [
      {
        "id": "A",
        "name": "标签条",
        "role": "类目/领域标签、直播平台感",
        "limit": "≤12字",
        "anchor": "top"
      },
      {
        "id": "B",
        "name": "主标题",
        "role": "直播主题提炼（核心信息，必须体现主题）",
        "limit": "≤14字 / 最多2行 / 每行≤7字",
        "anchor": "upper-middle"
      },
      {
        "id": "C",
        "name": "副标题",
        "role": "主题延展、利益点或人群指向",
        "limit": "≤14字 / 1行",
        "anchor": "middle"
      },
      {
        "id": "D",
        "name": "角标徽章",
        "role": "开播时间 / 预约 / 限量等强引导",
        "limit": "≤12字",
        "anchor": "varies"
      },
      {
        "id": "E",
        "name": "底部信息条",
        "role": "机构/讲师署名 + 引导语（graphic 版式）",
        "limit": "≤18字",
        "anchor": "bottom"
      },
      {
        "id": "F",
        "name": "人物区",
        "role": "主播半身像（person 版式）或底部图标卡（graphic 版式）",
        "limit": "半身像 1 张 / 图标卡 2 枚",
        "anchor": "bottom-right|bottom-corners"
      },
      {
        "id": "G",
        "name": "签名胶囊",
        "role": "机构 Logo + 圆形头像 + 姓名·头衔 ｜ 机构名（person 版式）",
        "limit": "≤24字，超长自动降级",
        "anchor": "below-copy"
      }
    ],
    "layoutModes": [
      {
        "id": "person",
        "name": "人物版式",
        "trigger": "已选择主播半身像",
        "arrange": "横版左右分栏（文案左 / 人物右）；方版与竖版上下分层（文案上 / 人物下）",
        "note": "半身像与文案错位排布并在前景之外：人物画在文字下层、底部出血柔化融入背景，主题信息永不被遮挡。未抠底的照片自动降级为拱形人物卡。"
      },
      {
        "id": "graphic",
        "name": "无人物版式",
        "trigger": "未选择半身像",
        "arrange": "文案居中通栏，底部两侧圆角图标卡",
        "note": "没有人物素材时的兜底排版：文案占据视觉中心，左下主播头像卡 + 右下机构 Logo 卡对应参考图的图标卡语言。"
      }
    ],
    "personGeometry": {
      "note": "人物版式几何参数，全部相对画布。bleed 为底部出血上限——抠底立绘按 maxWidthRatio 取目标宽度后，多出来的高度从画布底部裁掉，腰际的硬切边落在画布之外；宁可从底部多裁一点，也不让人物缩成小图。topRatio 为人物可占据的最高位置（同时是文案区的下界）；maxWidthRatio 限制人物宽度，保证文案栏宽度足够。未抠底的照片不出血，改为画布内的拱形人物卡。",
      "wide": {
        "label": "横版（16:9 / 2.35:1）",
        "textWidthRatio": 0.53,
        "topRatio": 0.155,
        "bleed": 0.16,
        "maxWidthRatio": 0.46
      },
      "square": {
        "label": "方版（1:1）",
        "textWidthRatio": 0.86,
        "topRatio": 0.4,
        "bleed": 0.34,
        "maxWidthRatio": 0.62
      },
      "tall": {
        "label": "竖版（9:16 / 3:4）",
        "textWidthRatio": 0.86,
        "topRatio": 0.4,
        "bleed": 0.26,
        "maxWidthRatio": 0.74
      }
    },
    "typography": {
      "fontFamilies": {
        "sans": {
          "label": "现代黑体（专业/洞察）",
          "source": "Hiragino Sans GB",
          "files": {
            "regular": "fonts/sans-regular.ttf",
            "bold": "fonts/sans-bold.ttf"
          },
          "note": "由系统字体子集化而来（tools/subset_fonts.py），随站点分发，本地与线上同一份字形"
        },
        "serif": {
          "label": "宋体（稳重/岁月感）",
          "source": "Songti SC",
          "files": {
            "regular": "fonts/serif-regular.ttf",
            "bold": "fonts/serif-bold.ttf"
          },
          "note": "同上"
        }
      },
      "scaleByShortSide": {
        "label": 0.03,
        "title": 0.112,
        "subtitle": 0.045,
        "badge": 0.038,
        "footer": 0.028
      }
    },
    "safeMargin": 0.072,
    "sizes": {
      "1:1": [
        1080,
        1080
      ],
      "3:4": [
        1080,
        1440
      ],
      "9:16": [
        1080,
        1920
      ],
      "16:9": [
        1920,
        1080
      ],
      "2.35:1": [
        1800,
        766
      ]
    },
    "anchorMaterials": {
      "note": "主播素材库。半身像决定走人物版式还是无人物版式；头像只出现在签名胶囊的圆形小标里；Logo 出现在签名胶囊或底部图标卡。留空都有内置字形兜底。",
      "roles": [
        {
          "id": "portrait",
          "name": "主播半身像",
          "slot": "main",
          "shape": "cutout",
          "note": "版式主角。建议竖版半身照（头部完整、到腰际）；自动去头顶留白 + 按 0.72 画幅取头肩 + 可选自动抠底"
        },
        {
          "id": "avatar",
          "name": "主播头像",
          "slot": "signature",
          "shape": "circle",
          "note": "签名胶囊里的圆形小头像，建议正方形正面照，自动方裁"
        },
        {
          "id": "logo",
          "name": "机构 Logo",
          "slot": "corner",
          "shape": "contain",
          "note": "建议透明底 PNG，自动等比容纳并留白"
        }
      ]
    },
    "platforms": [
      {
        "id": "live",
        "name": "直播间封面",
        "kind": "直播",
        "short": "直播",
        "sizes": [
          "1:1",
          "3:4",
          "9:16",
          "16:9",
          "2.35:1"
        ],
        "defaultSizes": [
          "1:1",
          "9:16"
        ],
        "safeArea": {
          "top": 0.0,
          "bottom": 0.0,
          "note": "直播封面自持画布，无平台 UI 遮挡"
        },
        "families": [
          "classic",
          "youth"
        ],
        "zonesNote": "沿用五分区骨架 + 主播挂件区；有半身像走人物版式，无半身像走无人物版式",
        "note": "视频号 / 抖音直播 / 企微社群 / 公众号全部复用，按尺寸各出一版。"
      },
      {
        "id": "xhs",
        "name": "小红书图文",
        "kind": "图文",
        "short": "小红书",
        "sizes": [
          "3:4",
          "1:1"
        ],
        "defaultSizes": [
          "3:4"
        ],
        "safeArea": {
          "top": 0.028,
          "bottom": 0.04,
          "note": "顶部留作者行，底部留话题标签带；四边再留 6% 出血余量"
        },
        "families": [
          "xhs"
        ],
        "zonesNote": "A 作者行 / B 标签条 / C 超大黑体主标题（关键词荧光高亮）/ D 副标题 / E 话题标签带 / F 页码或角标",
        "note": "笔记首图。竖版 3:4 是信息流里占屏最大的比例，标题必须做到「一屏只读三四个字就懂」。"
      },
      {
        "id": "dy_image",
        "name": "抖音图文",
        "kind": "图文",
        "short": "抖音图文",
        "sizes": [
          "3:4"
        ],
        "defaultSizes": [
          "3:4"
        ],
        "safeArea": {
          "top": 0.055,
          "bottom": 0.085,
          "note": "顶部避让搜索栏，底部避让文案区与互动条；右下留页码位"
        },
        "families": [
          "douyin"
        ],
        "zonesNote": "A 话题条 / B 超大描边主标题（居中）/ C 高亮副标题 / D 角标胶囊 / E 账号行 / F 页码 1/N",
        "note": "图文轮播首图。第 1 张定点击率，后面几张可复用同一模板换序号继续出图。"
      },
      {
        "id": "dy_video",
        "name": "抖音视频封面",
        "kind": "视频",
        "short": "抖音视频",
        "sizes": [
          "9:16"
        ],
        "defaultSizes": [
          "9:16"
        ],
        "safeArea": {
          "top": 0.14,
          "bottom": 0.22,
          "note": "顶部 14% 让开状态栏与搜索栏，底部 22% 让开昵称、文案、音乐条与评论框"
        },
        "families": [
          "douyin"
        ],
        "zonesNote": "A 话题条 / B 超大描边主标题（居中，落在安全区内）/ D 角标胶囊 / E 账号行 / F 时长角标",
        "note": "全屏首帧封面。抖音会把封面压在右侧信息栏之下，所有关键文字必须落在安全区内。"
      }
    ]
  },
